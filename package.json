{
  "name": "adivinalapeli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm catalog:ensure && next build",
    "postbuild": "tsx scripts/build-service-worker.ts",
    "preview": "tsx scripts/serve-static.ts",
    "catalog:ensure": "tsx scripts/sync-movies.ts",
    "catalog:refresh": "tsx scripts/sync-movies.ts --force",
    "format": "oxfmt --config .oxfmtrc.json --disable-nested-config --write .",
    "format:check": "oxfmt --config .oxfmtrc.json --disable-nested-config --check .",
    "lint": "oxlint -c .oxlintrc.json --disable-nested-config --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "pnpm build && playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.20.0"
}
